# ============================================================
# RumoPRF — Variáveis de ambiente
# Copie este arquivo para `.env` e preencha os valores.
# NUNCA commite o arquivo `.env` (ele está no .gitignore).
# ============================================================

# Chave da plataforma Lovable — usada pelo servidor para chamar
# o gateway de conectores (Google Drive).
# Obtida automaticamente no ambiente Lovable; para uso local,
# copie o valor em: Projeto → Configurações → Segredos.
LOVABLE_API_KEY=

# Chave da conexão do Google Drive (connector gateway).
# Criada automaticamente ao vincular a conexão do Google Drive
# ao projeto. Para uso local, copie o valor em:
# Projeto → Configurações → Segredos.
GOOGLE_DRIVE_API_KEY=
